<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Каталог</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-main">
                <img src="img/list1.webp" alt="" class="block-main__pic1">
                <img src="img/list2.webp" alt="" class="block-main__pic2">
                <div class="container">
                    <div class="block-main__contents">
                        <div class="breadcrumbs">
                            <ul>
                                <li>
                                    <a href="#" class="home">
                                        <img src="img/icons/home.svg" alt="">
                                    </a>
                                </li>
                                <li><span>Каталог продукции</span></li>
                            </ul>
                        </div>
                        <div class="block-main__content">
                            <div class="block-main__top">
                                <h1 class="title1">
                                    <strong>Каталог продукции</strong>
                                </h1>
                            </div>
                            <div class="block-search">
                                <div class="block-search__input">
                                    <div class="block-search__icon">
                                        <svg aria-hidden="true" width="20" height="20">
                                            <use xlink:href="img/sprite.svg#search"></use>
                                        </svg>
                                    </div>
                                    <input autocomplete="off" type="text" name="form[]"
                                        placeholder="Введите название товара или артикул (SKU) ...">
                                    <button type="button" class="block-search__delete">
                                        <svg aria-hidden="true" width="10" height="10">
                                            <use xlink:href="img/sprite.svg#close"></use>
                                        </svg>
                                    </button>
                                </div>
                                <button type="submit" class="btn btn-blue">
                                    <span>Найти</span>
                                    <div class="btn__arrow">
                                        <svg aria-hidden="true" width="14" height="9">
                                            <use xlink:href="img/sprite.svg#arrow1"></use>
                                        </svg>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-catalog">
                <div class="container">
                    <div class="heading-complex">
                        <h2 class="title2">
                            <span>Собственные</span> торговые марки
                        </h2>
                    </div>
                    <div class="block-catalog__cards">
                        <a href="./" class="block-catalog__card">
                            <img src="img/image21.webp" alt="" class="block-catalog__pic1">
                            <p>
                                BRATAN
                            </p>
                        </a>
                        <a href="./" class="block-catalog__card">
                            <img src="img/image22.webp" alt="" class="block-catalog__pic1">
                            <p>
                                MYBRO
                            </p>
                        </a>
                        <a href="./" class="block-catalog__card">
                            <img src="img/image23.webp" alt="" class="block-catalog__pic1">
                            <p>
                                BRATICO
                            </p>
                        </a>
                    </div>
                </div>
            </div>

            <div class="block-imported-product">
                <div class="container">
                    <div class="block-imported-product__content">
                        <div class="heading-complex">
                            <h2 class="title2">
                                <span>Импортный</span> ассортимент
                            </h2>
                        </div>
                        <div class="block-imported-product__body">
                            <div class="block-imported-product__slider swiper">
                                <div class="block-imported-product__wrapper swiper-wrapper">
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image15.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Безалкогольные напитки
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image16.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Бакалея
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image17.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Пиво
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image18.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Снеки
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image19.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Чипсы
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image18.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Снеки
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="block-imported-product__slide swiper-slide">
                                        <a href="./" class="card-catalog card-catalog2">
                                            <div class="card-catalog__image">
                                                <img loading="lazy" src="img/image19.webp" alt="">
                                                <div class="card-catalog__arrow">
                                                    <svg aria-hidden="true" width="14" height="9">
                                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="card-catalog__item">
                                                <div class="card-catalog__titles">
                                                    <div class="card-catalog__title">
                                                        Чипсы
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="imported-product-arrow-prev slider-nav arrow-prev">
                            <svg aria-hidden="true" width="30" height="9">
                                <use xlink:href="img/sprite.svg#arrow2"></use>
                            </svg>
                        </button>
                        <button type="button" class="imported-product-arrow-next slider-nav arrow-next">
                            <svg aria-hidden="true" width="30" height="9">
                                <use xlink:href="img/sprite.svg#arrow2"></use>
                            </svg>
                        </button>
                        <div class="block-imported-product__svg">
                            <svg aria-hidden="true" width="1810" height="461">
                                <use xlink:href="img/sprite.svg#logo2"></use>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="block-forms block-forms2">
                <img src="img/image6.webp" alt="" class="block-forms__pic1">
                <img src="img/image7.webp" alt="" class="block-forms__pic2">
                <div class="container">
                    <div class="block-forms__content">
                        <div class="block-forms__left">
                            <div class="heading-complex">
                                <h2 class="title2">
                                    <span>Нужен полный прайс-лист в Excel?</span>
                                </h2>
                                <p>
                                    Получить актуальный ассортимент и индивидуальные условия поставки для вашего региона
                                </p>
                            </div>
                        </div>
                        <form action="#" class="form">
                            <div class="form__inputs">
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="ИНН компании *" class="input">
                                    <div class="form__placeholder">
                                        ИНН компании <span>*</span>
                                    </div>
                                </div>
                                <div class="form__input">
                                    <input data-required autocomplete="off" type="text" name="form[]"
                                        placeholder="E-mail *" class="input">
                                    <div class="form__placeholder">
                                        E-mail <span>*</span>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-blue btn-big">
                                <span>Запросить ассортимент и условия поставки-лист</span>
                                <div class="btn__arrow">
                                    <svg aria-hidden="true" width="14" height="9">
                                        <use xlink:href="img/sprite.svg#arrow1"></use>
                                    </svg>
                                </div>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/scripts.njk' %}
</body>

</html>